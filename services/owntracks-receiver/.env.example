# OwnTracks Receiver — required environment variables
# Copy this file to .env or export these before starting the server.

# REQUIRED: Shared secret used as Bearer token by OwnTracks app.
# Generate with: openssl rand -hex 32
OWNTRACKS_API_KEY=replace_with_your_secret_key

# Optional overrides (defaults shown)
OWNTRACKS_PORT=9090
OWNTRACKS_STALE_SECONDS=300
OWNTRACKS_RATE_LIMIT=10
OWNTRACKS_MAX_BODY=4096