# Hermes Tour Assistant — required environment variables
# Copy this file to .env or export these before running the gate.

# REQUIRED: Telegram Chat-ID for location monitoring
HERMES_TOUR_CHAT_ID=DEINE_TELEGRAM_CHAT_ID

# Activity type: "cycling" or "walking"
HERMES_TOUR_ACTIVITY=cycling
HERMES_TOUR_LOCALE=de-DE
HERMES_TOUR_LOCATION_MAX_AGE_SECONDS=300

# Optional: OwnTracks fallback location source
HERMES_OWNTRACKS_URL=http://127.0.0.1:9090/location

# Optional: profile thresholds (defaults apply if unset)
# HERMES_TOUR_MOVE_THRESHOLD_M=50
# HERMES_TOUR_OFF_ROUTE_ENTER_M=200
# HERMES_TOUR_OFF_ROUTE_EXIT_M=50
# HERMES_TOUR_SETTLEMENT_APPROACH_M=1000
# HERMES_TOUR_FINISH_APPROACH_M=100

# City Walk Guide specific (optional)
# HERMES_CITY_GUIDE_CHAT_ID=DEINE_CHAT_ID
# OPENROUTESERVICE_API_KEY=dein_ors_key
# New default; use telegram,owntracks to preserve the pre-abstraction priority.
HERMES_LOCATION_SOURCE_ORDER=owntracks,telegram

# Deterministic Movement Engine (optional; validated together)
# HERMES_MOVEMENT_STATIONARY_RADIUS_M=15
# HERMES_MOVEMENT_STATIONARY_MIN_SECONDS=90
# HERMES_MOVEMENT_START_DISTANCE_M=20
# HERMES_MOVEMENT_START_MIN_SECONDS=20
# HERMES_MOVEMENT_WALK_MAX_MPS=2.6
# HERMES_MOVEMENT_CYCLING_MAX_MPS=10
# HERMES_MOVEMENT_AUTOMOTIVE_MIN_MPS=10
# HERMES_MOVEMENT_HEADING_CHANGE_DEG=45
# HERMES_MOVEMENT_SHORT_GAP_SECONDS=180
# HERMES_MOVEMENT_LONG_GAP_SECONDS=900
# HERMES_MOVEMENT_MAX_PLAUSIBLE_MPS=70
# HERMES_MOVEMENT_STATE_DIR=~/.local/state/hermes/movement

# Same explicit value must be passed to OwnTracks and Telegram adapters for one device.
# HERMES_LOCATION_CANONICAL_DEVICE_ID=maik-iphone
